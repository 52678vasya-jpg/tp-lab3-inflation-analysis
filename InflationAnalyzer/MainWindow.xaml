<Window x:Class="InflationAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="Inflation Analyzer"
        Height="700"
        Width="1000">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                    Margin="0 0 0 10">

            <Button x:Name="LoadButton"
                    Content="Load CSV"
                    Width="150"
                    Height="35"
                    Margin="0 0 10 0"
                    Click="LoadButton_Click"/>

            <Button x:Name="ForecastButton"
                    Content="Forecast"
                    Width="150"
                    Height="35"
                    Click="ForecastButton_Click"/>

        </StackPanel>

        <GroupBox Header="Inflation Data Table"
                  Grid.Row="1"
                  Margin="0 0 0 10">

            <DataGrid x:Name="InflationGrid"
                      AutoGenerateColumns="True"/>
        </GroupBox>

        <GroupBox Header="Inflation Chart"
                  Grid.Row="2">

            <oxy:PlotView x:Name="PlotView"/>

        </GroupBox>

    </Grid>
</Window>